  "html": "<div><span class=\"tok-punctuation\">&#60;</span><span class=\"tok-typeName\">Group</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName\">onLayoutChanged</span><span class=\"tok-operator\">=</span><span class=\"tok-punctuation\">{</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">layout</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">isUserInteraction</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// `isUserInteraction` is true only when the user has just</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// finished dragging a separator. It is false for every other</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// source: initial mount, programmatic setLayout, parent re-render,</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// or a min/max size constraint clamp caused by a container</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// width change. Gate persistence on this flag so per-user</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// viewport adjustments are not written back to shared state.</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-keyword\">if</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">isUserInteraction</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</spa